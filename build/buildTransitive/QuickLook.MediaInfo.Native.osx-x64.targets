<Project>
  <Target Name="QuickLookMediaInfoCopyNativeOsxX64" AfterTargets="Build">
    <PropertyGroup>
      <_QuickLookMediaInfoNativeSource>$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\libmediainfo.dylib</_QuickLookMediaInfoNativeSource>
      <_QuickLookMediaInfoNativeOutputDir>$(TargetDir)osx-x64\</_QuickLookMediaInfoNativeOutputDir>
      <_QuickLookMediaInfoNativeDestination>$(_QuickLookMediaInfoNativeOutputDir)libmediainfo.dylib</_QuickLookMediaInfoNativeDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_QuickLookMediaInfoNativeOutputDir)" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
    <Copy SourceFiles="$(_QuickLookMediaInfoNativeSource)" DestinationFiles="$(_QuickLookMediaInfoNativeDestination)" SkipUnchangedFiles="true" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
  </Target>
</Project>
