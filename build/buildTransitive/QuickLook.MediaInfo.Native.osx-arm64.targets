<Project>
  <Target Name="QuickLookMediaInfoCopyNativeOsxArm64" AfterTargets="Build">
    <PropertyGroup>
      <_QuickLookMediaInfoNativeSource>$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\libmediainfo.0.dylib</_QuickLookMediaInfoNativeSource>
      <_QuickLookMediaInfoNativeOutputDir>$(TargetDir)osx-arm64\</_QuickLookMediaInfoNativeOutputDir>
      <_QuickLookMediaInfoNativeDestination>$(_QuickLookMediaInfoNativeOutputDir)libmediainfo.0.dylib</_QuickLookMediaInfoNativeDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_QuickLookMediaInfoNativeOutputDir)" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
    <Copy SourceFiles="$(_QuickLookMediaInfoNativeSource)" DestinationFiles="$(_QuickLookMediaInfoNativeDestination)" SkipUnchangedFiles="true" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
  </Target>
</Project>
