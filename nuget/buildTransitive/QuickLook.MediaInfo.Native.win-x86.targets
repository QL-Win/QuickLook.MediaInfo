<Project>
  <Target Name="QuickLookMediaInfoCopyNativeWinX86" AfterTargets="Build">
    <PropertyGroup>
      <_QuickLookMediaInfoNativeSource>$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\MediaInfo.dll</_QuickLookMediaInfoNativeSource>
      <_QuickLookMediaInfoNativeOutputDir>$(TargetDir)win-x86\</_QuickLookMediaInfoNativeOutputDir>
      <_QuickLookMediaInfoNativeDestination>$(_QuickLookMediaInfoNativeOutputDir)MediaInfo.dll</_QuickLookMediaInfoNativeDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_QuickLookMediaInfoNativeOutputDir)" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
    <Copy SourceFiles="$(_QuickLookMediaInfoNativeSource)" DestinationFiles="$(_QuickLookMediaInfoNativeDestination)" SkipUnchangedFiles="true" Condition="Exists('$(_QuickLookMediaInfoNativeSource)')" />
  </Target>
</Project>
